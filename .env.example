# Copy this file to .env and replace placeholder values. Do not commit .env.

# PostgreSQL service credentials. DATABASE_URL is constructed by Compose with
# the postgres service hostname, so do not use localhost for the backend URL.
POSTGRES_DB=workflow_db
POSTGRES_USER=workflow_user
POSTGRES_PASSWORD=replace-with-a-strong-password

# Required to call the protected API endpoints.
CLERK_SECRET_KEY=••••••••••••••••••••••••••••••••••••••••••••••••••
CLERK_PUBLISHABLE_KEY=pk_test_d29ya2FibGUtYmVhci00MDg2LmNsZXJrLmFjY291bnRzLmRldiQ
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Required only for live AI risk analysis.
OPENAI_API_KEY=
OPENAI_RISK_MODEL=gpt-4.1-mini

# Browser-facing value embedded when the frontend image is built.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_d29ya2FibGUtYmVhci00MDg2LmNsZXJrLmFjY291bnRzLmRldiQ
